# --- Server --------------------------------------------------
PORT=4400
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Database ------------------------------------------------
# sqlite (zero-setup local dev) | postgres (staging / production)
DB_TYPE=sqlite
DB_SQLITE_PATH=data/segue-hrms.sqlite
DATABASE_URL=postgres://postgres:postgres@localhost:5432/segue_hrms
# Auto-sync schema from entities. Disable in production and use migrations.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Auth ----------------------------------------------------
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# --- Files ---------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
